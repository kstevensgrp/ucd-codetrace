{
  "name": "ucd-codetrace",
  "version": "1.0.0",
  "description": "CodeTrace at UC Davis (fork of Python Tutor v5-unity)",
  "private": true,
  "repository": "https://github.com/kstevensgrp/ucd-codetrace",
  "license": "MIT",
  "scripts": {
    "start": "python3 bottle_server.py",
    "build": "NODE_OPTIONS=--openssl-legacy-provider webpack && python3 add_cache_busting_query_strings.py",
    "watch": "NODE_OPTIONS=--openssl-legacy-provider webpack --devtool sourcemap --progress --watch",
    "production-build": "rm -f build/* && npm run build"
  },
  "devDependencies": {
    "css-loader": "0.28.11",
    "script-loader": "0.7.2",
    "style-loader": "0.21.0",
    "ts-loader": "3.5.0",
    "typescript": "2.9.2",
    "url-loader": "1.1.2",
    "file-loader": "1.1.11",
    "webpack": "3.12.0"
  }
}
